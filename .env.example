# ── Core ──────────────────────────────────────────────────────────────────────

# Local PostgreSQL (via docker-compose) or Zerops Managed PostgreSQL in prod
# In Zerops: reference as ${db_connectionString} from the managed Postgres service
DATABASE_URL=postgresql://forgeos:forgeos_dev_password@localhost:5432/forgeos_dev

# Local Redis (via docker-compose) or Zerops Managed Valkey in prod
# In Zerops: reference as ${cache_connectionString} from the Valkey service
REDIS_URL=redis://localhost:6379

# ── AI (OpenAI-compatible provider) ──────────────────────────────────────────
# Groq is recommended — fast LPU inference, OpenAI-compatible endpoint.
# Get a key at https://console.groq.com/keys
AI_API_KEY=                    # Groq API key (gsk_...)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ── Zerops ───────────────────────────────────────────────────────────────────
# For GitHub-based deploys, connect the repo to Zerops in the service pipeline
# settings. zCLI is optional and only needed for terminal-driven imports/deploys.
ZEROPS_PROJECT_ID=
ZEROPS_PROJECT_NAME=
ZEROPS_REGION=prg1

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                  # PAT with repo + workflow scopes
GITHUB_ORG=                    # Your GitHub username or org

# ── Golden Boilerplate ────────────────────────────────────────────────────────
# The Next.js + Prisma boilerplate Shipyard clones and injects into
GOLDEN_BOILERPLATE_REPO=       # e.g. your-org/forgeos-boilerplate
GOLDEN_BOILERPLATE_SHA=        # Pinned commit SHA for reproducibility

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ── Demo ──────────────────────────────────────────────────────────────────────
DEMO_AGENCY_ID=demo-agency-cuid  # Must match what seed script creates

# ── Object Storage (optional, for RAG agency memory) ──────────────────────────
# Zerops Object Storage (S3-compatible) or any S3-compatible provider
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=              # e.g. https://storage.zerops.io or your S3 endpoint
STORAGE_REGION=us-east-1
STORAGE_BUCKET=forgeos-memory
